<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="vaimo_gas_v2_maps_api" type="host">https://maps.googleapis.com</value>
                <value id="vaimo_gas_v2_maps_static" type="host">https://maps.gstatic.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="vaimo_gas_v2_maps_api" type="host">https://maps.googleapis.com</value>
                <value id="vaimo_gas_v2_places_api" type="host">https://places.googleapis.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="vaimo_gas_v2_maps_static" type="host">https://maps.gstatic.com</value>
                <value id="vaimo_gas_v2_maps_api" type="host">https://maps.googleapis.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
